#!/bin/bash
# set -euxo pipefail

rm -f /etc/machine-id ; dbus-uuidgen --ensure=/etc/machine-id


cat << EOF > /root/bootstrapfix.sh
#!/bin/bash
mount /dev/sdb /opt/instruqt/bootstrap/
/opt/instruqt/bootstrap/setup.sh
EOF

chmod +x /root/bootstrapfix.sh

transactional-update run /root/bootstrapfix.sh


echo "[INFO] Waiting for Instruqt bootstrap to complete..."
timeout 60 bash -c 'until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do sleep 1; done' || echo "[WARN] Timeout waiting for bootstrap, continuing anyway"



echo ''|base64 -d |xz -d >/var/lib/containers/storage/volumes/root/_data/change_hostname
chmod +x /var/lib/containers/storage/volumes/root/_data/change_hostname

mgrctl exec -- /root/change_hostname 1.1.1.1  --skip-ip-validation --password=Admin123 --auto --hostname=smlm.${_SANDBOX_ID}.instruqt.io








# 0. Insruqt init
#################


# makes sure the registration is ok
#registercloudguest --force-new


echo '# grant remote access'
cat << EOF >> /root/.ssh/authorized_keys
$SSH_PUB_KEY
EOF


local_ip=`ip -4 addr show eth0 | grep -oP '(?<=inet\s)\d+(\.\d+){3}'`


echo '# Add generic bootstrap script'
curl -skL "${SMLM_SCRIPTS_URL}"/generic_bootstrap.sh > /var/lib/containers/storage/volumes/srv-www/_data/htdocs/pub/bootstrap/generic_bootstrap.sh
chmod a+x /var/lib/containers/storage/volumes/srv-www/_data/htdocs/pub/bootstrap/generic_bootstrap.sh

echo '# set auto accept for salt keys'
sed 's/#.*auto_accept:.*/auto_accept: True/' -i /var/lib/containers/storage/volumes/etc-salt/_data/master




echo '# update SSL Certificate'
mgrctl exec -- mv /root/ssl-build /root/old-ssl-build

mgrctl exec -ti -- rhn-ssl-tool --gen-ca --dir="/root/ssl-build" --set-country="CH" \
--set-state="LU" --set-city="Luzern" --set-org="${SMLM_ORGNAME}" \
--set-org-unit="IT" --set-common-name="SUSEManagerCACertificate" \
--set-email="admin@dontexi.st" -p 1234

mgrctl exec -ti -- rhn-ssl-tool --gen-server --dir="/root/ssl-build" --set-country="CH" \
--set-state="LU" --set-city="Luzern" --set-org="${SMLM_ORGNAME}" \
--set-org-unit="IT" --set-email="admin@dontexi.st" \
--set-hostname="smlm.${_SANDBOX_ID}.instruqt.io" --set-cname="smlm.${_SANDBOX_ID}.instruqt.io" \
--set-cname="smlm.aaaaa.instruqt.io" -p 1234


curl -s -o /var/lib/containers/storage/volumes/root/_data/ssl-build/smlm.${_SANDBOX_ID}/server.crt -H "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/instance/attributes/ssl-certificate"
curl -s -o /var/lib/containers/storage/volumes/root/_data/ssl-build/smlm.${_SANDBOX_ID}/server.key -H "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/instance/attributes/ssl-certificate-key"



podman secret create --replace uyuni-ca /var/lib/containers/storage/volumes/root/_data/ssl-build/RHN-ORG-TRUSTED-SSL-CERT
podman secret create --replace uyuni-cert /var/lib/containers/storage/volumes/root/_data/ssl-build/smlm.${_SANDBOX_ID}/server.crt
podman secret create --replace uyuni-key /var/lib/containers/storage/volumes/root/_data/ssl-build/smlm.${_SANDBOX_ID}/server.key
mgradm restart

sleep 60


echo '###################### Completed smlm setup #################
######################################################################'

shutdown -r 0 &



