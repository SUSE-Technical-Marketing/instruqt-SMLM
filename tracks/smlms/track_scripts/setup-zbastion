# app.py
# This is the main Flask application file.
# To run this, you would typically use a WSGI server like Gunicorn or mod_wsgi with Apache.
# For development:
# 1. pip install Flask
# 2. export FLASK_APP=app.py
# 3. flask run

from flask import Flask, render_template, request
import subprocess

app = Flask(__name__)

@app.route('/check', methods=['POST'])
def check_exercise():
    """
    Handles the form submission.
    Runs a script and renders a success or failure page based on the exit code.
    """
    if request.method == 'POST':
        exercise_id = request.form.get('exercise_id')
        action = request.form.get('action')

        # --- Security Note ---
        # In a real-world application, directly running a script with user-provided
        # input is dangerous. You should sanitize and validate the 'exercise_id'
        # to ensure it matches an expected value and prevent command injection.
        # For this example, we'll assume 'exercise_id' is a safe, known value.

        if action == 'check' and exercise_id:
            try:
                # Construct the command to run the shell script
                # The script needs to be executable (chmod +x check_exercise.sh)
                command = ['./check_exercise.sh', exercise_id]

                # Run the script and capture the result
                result = subprocess.run(command, capture_output=True, text=True)

                # Check the exit code of the script
                if result.returncode == 0:
                    # Success! Render the success page.
                    return render_template('success.html', exercise_id=exercise_id)
                else:
                    # Failure! Render the failure page.
                    # You can pass the error output to the template if needed
                    error_message = result.stderr or result.stdout
                    return render_template('failure.html', exercise_id=exercise_id, error=error_message)

            except FileNotFoundError:
                # This error occurs if the script doesn't exist or isn't executable
                return render_template('failure.html', exercise_id=exercise_id, error="Error: The check script was not found on the server.")
            except Exception as e:
                # Catch any other exceptions
                return render_template('failure.html', exercise_id=exercise_id, error=f"An unexpected error occurred: {e}")

    # If the request is not valid, redirect to the home page
    return render_template('index.html')
EOF



